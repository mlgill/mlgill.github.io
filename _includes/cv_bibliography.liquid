{%- comment -%}
CV Bibliography section using cached bibliography data
Include with: {% include cv_bibliography.liquid selected_only=false %}
Parameters:
  - selected_only: if true, only show entries with selected=true (for concise CV)
{%- endcomment -%}
{%- assign selected_only = include.selected_only | default: false -%}
<ol class="bibliography">
{%- for entry in site.data.bibliography_cache -%}
  {%- if selected_only == true and entry.selected != true -%}
    {%- continue -%}
  {%- endif -%}
  <li>
    <div class="publication-entry">
      <span class="authors">
        {%- for author in entry.author_array -%}
          {% assign author_is_self = false %}
          {%- assign author_last_name = author.last | remove: '*' | remove: '∗' | remove: '†' | remove: '‡' | remove: '§' | remove: '¶' | remove: '‖' | remove: '&' | remove: '^' -%}
          {% if site.scholar.last_name contains author_last_name %}
            {% if site.scholar.first_name contains author.first %}
              {% assign author_is_self = true %}
            {% endif %}
          {%- endif -%}
          {%- if forloop.length > 1 -%}
            {% if forloop.first == false -%}, {% endif %}
            {%- if forloop.last %}and {% endif -%}
          {% endif %}
          {%- if author_is_self -%}<u>{{ author.first }} {{ author.last }}</u>{%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
        {%- endfor -%}
      </span>
      {% if entry.doi %}
        <span class="title"><a href="https://doi.org/{{ entry.doi }}" target="_blank">"{{ entry.title }}"</a></span>
      {% elsif entry.html %}
        <span class="title"><a href="{{ entry.html }}" target="_blank">"{{ entry.title }}"</a></span>
      {% else %}
        <span class="title">"{{ entry.title }}"</span>
      {% endif %}
      <span class="venue"><em>{{ entry.journal }}</em></span>
      {% if entry.year %}<span class="year">({{ entry.year }})</span>{% endif %}.
    </div>
  </li>
{%- endfor -%}
</ol>
