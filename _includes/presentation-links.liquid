{% comment %}
  Renders the link list for one presentation.
  Required parameters:
    links        - the presentation's links map (slides, video, abstract, program, code, thesis)
    class_prefix - CSS class prefix placed before the link kind
    label_case   - "capitalize" or "upcase"
    separator    - text between consecutive links
    prefix       - text emitted before the list when at least one link exists
{% endcomment %}
{%- assign link_types = 'slides,video,abstract,program,code,thesis' | split: ',' -%}
{%- capture presentation_links -%}
  {%- assign current_separator = '' -%}
  {%- for kind in link_types -%}
    {%- assign url = include.links[kind] -%}
    {%- if url -%}
      {%- if include.label_case == 'upcase' -%}{%- assign label = kind | upcase -%}{%- else -%}{%- assign label = kind | capitalize -%}{%- endif -%}
      {{- current_separator -}}<a href="{{ url }}" class="{{ include.class_prefix }}{{ kind }}">{{ label }}</a>
      {%- assign current_separator = include.separator -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if presentation_links != empty -%}
  {{- include.prefix }}{{ presentation_links }}
{%- endif -%}
