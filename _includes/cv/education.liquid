<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in include.data %}
    {% if content.visible == false %}{% continue %}{% endif %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.year %}
            <table class="table-cv">
              <tbody>
                <tr>
                  <td>
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                      {{ content.year }}
                    </span>
                  </td>
                </tr>
                {% if content.location %}
                  <tr>
                    <td>
                      <p class="location">
                        <i class="fa-solid fa-location-dot iconlocation"></i>
                        {{ content.location }}
                      </p>
                    </td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.title }}</h6>
          {% if content.institution %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem"><i class="fa-solid fa-building-columns iconinstitution"></i> {{ content.institution }}</h6>
          {% endif %}
          {% if content.description %}
            <ul class="items ml-1 ml-md-4">
              {% for item in content.description %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
