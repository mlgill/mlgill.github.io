<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in entry.contents %}
    {% if content.visible == false %}{% continue %}{% endif %}
    <li class="list-group-item">
      <div class="publication-entry">
        <span class="authors">{{ content.description | first }}</span>
        {% assign doi_link = nil %}
        {% if content.linkitems %}
          {% for item in content.linkitems %}
            {% if item.link %}
              {% assign doi_link = item.link %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if doi_link %}
          <span class="title"><a href="{{ doi_link }}" target="_blank">"{{ content.title }}"</a></span>
        {% else %}
          <span class="title">"{{ content.title }}"</span>
        {% endif %}
        <span class="venue"><em>{{ content.institution }}</em></span>
        {% if content.year %}<span class="year">({{ content.year }})</span>{% endif %}.
      </div>
    </li>
  {% endfor %}
</ul>
