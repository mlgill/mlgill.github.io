<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ page.title }} | CV</title>
  {% comment %}Calculate relative path to site root based on page depth{% endcomment %}
  {% assign path_parts = page.url | split: '/' | size | minus: 1 %}
  {% assign rel_path = '' %}
  {% for i in (1..path_parts) %}{% assign rel_path = rel_path | append: '../' %}{% endfor %}
  <style>
{% include cv-print-styles.liquid -%}
  </style>
</head>
<body>
  <div id="main">
    <div id="content">
      {{ content }}
    </div>
  </div>
</body>
</html>
